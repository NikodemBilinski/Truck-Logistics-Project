<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:TrucksLogisticsClient.Models"
             x:Class="TrucksLogisticsClient.Pages.MainMenuPage"
             NavigationPage.HasNavigationBar="False">

    
    <Grid ColumnDefinitions="220,*">

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="30">

            <!--UserDataHeader-->
            <Border x:Name="UserDataHeader"
                    Grid.Row="0"
                    StrokeShape="RoundRectangle 20,20,20,20"
                    WidthRequest="250">

                <Label x:Name="Welcome_User_Label"
                       Text="{Binding FirstName , StringFormat='Welcome, {0}!'}"
                       FontSize="30"
                       HorizontalOptions="Center"
                       Margin="0,10,0,10"/>
            </Border>


            <!--UserDataMain (zastanowic sie czy w ogole to umieszczac-->
            <Border x:Name="UserDataMain"
                    x:DataType="model:Users"
                    IsVisible="False"
                    StrokeShape="RoundRectangle 20,20,20,20"
                    WidthRequest="500"
                    Margin="20"
                    Padding="20"
                    Grid.Row="1">
                <VerticalStackLayout>
                    <Label Text="Profile Data:"
                           HorizontalOptions="Center"
                           FontSize="25"/>
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="{Binding FirstName}"/>
                        <Label Text="{Binding LastName}"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Age: "/>
                        <Label Text="{Binding Age}"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Role: "/>
                        <Label Text="{Binding Role}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            
        </Grid>
        <VerticalStackLayout Grid.Column="0" Margin="10">

            <!--Admin DataPanel-->
            <Border x:Name="Admin_Data_Panel"
                    StrokeThickness="5"
                    StrokeShape="RoundRectangle 50"
                    Stroke="Beige"
                    Padding="50"
                    IsVisible="False"
                    IsEnabled="False">
                <VerticalStackLayout Spacing="25">

                    <Button Text="Users And Trucks"
                            WidthRequest="160"
                            Clicked="Admin_MoveTo_UsersAndTrucks"/>
                    <Button Text="Jobs"
                            WidthRequest="160"
                            Clicked="Admin_MoveTo_Jobs"/>
                    <Button Text="Invoices And Clients"
                            WidthRequest="160"
                            Clicked="Admin_MoveTo_InvoicesAndClients"/>
                    <Button Text="Log Out"
                            WidthRequest="160"
                            Clicked="Admin_LogOut"/>


                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>